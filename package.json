{
  "name": "oopsmith-studio",
  "version": "0.2.1",
  "description": "3D agent office for Oopsmith Shorts",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p .",
    "dist": "node scripts/build.mjs && electron-builder --win"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/three": "^0.187.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "productName": "Oopsmith Studio",
  "type": "commonjs",
  "build": {
    "appId": "com.oopsmith.studio",
    "productName": "Oopsmith Studio",
    "files": [
      "dist/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=20"
  }
}